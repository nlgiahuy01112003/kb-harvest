GEMINI_API_KEY=REPLACE_ME
# API_KEY is also supported as an alias for Docker demos.
# API_KEY=REPLACE_ME

# Optional: leave blank on the first run and the script will create/save one in data/state.json.
GEMINI_FILE_SEARCH_STORE_NAME=

# Scraper settings
SUPPORT_BASE_URL=https://support.optisigns.com
SUPPORT_LOCALE=en-us
MAX_ARTICLES=35
# Always include articles needed for required sample questions, even if they are older than the first page.
SUPPORT_REQUIRED_ARTICLE_IDS=360051014713

# Gemini settings
GEMINI_STORE_DISPLAY_NAME=OptiSigns Support Articles
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
